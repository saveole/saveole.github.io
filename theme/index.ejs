<!DOCTYPE html>
<html lang="zh-CN">
<head>
<%- include('_head', { title: 'saveole\'s land' }) %>
</head>
<body>
<%- include('_nav', { activeNav: 'blog' }) %>

    <main id="main" class="container">
        <h1 class="sr-only">saveole's land</h1>
        <header class="home-header">
            <p class="contrib-title">Token 不够？<a href="running_page">跑步</a>来凑！ <span class="contrib-summary" id="contrib-summary"></span></p>
            <div class="contrib-wrapper">
                <div class="contrib-months" id="contrib-months"></div>
                <div class="contrib-body">
                    <div class="contrib-days">
                        <span>Mon</span><span>Wed</span><span>Fri</span>
                    </div>
                    <div class="contrib-grid" id="contrib-grid"></div>
                </div>
            </div>
            <div class="contrib-legend">
                <div class="legend-group">
                    <span class="legend-label">🏃 Less</span>
                    <span class="legend-cell run-0"></span>
                    <span class="legend-cell run-1"></span>
                    <span class="legend-cell run-2"></span>
                    <span class="legend-cell run-3"></span>
                    <span class="legend-cell run-4"></span>
                    <span class="legend-cell run-5"></span>
                    <span class="legend-label">More</span>
                </div>
                <span class="legend-divider"></span>
                <div class="legend-group">
                    <span class="legend-label">💻 Less</span>
                    <span class="legend-cell token-0"></span>
                    <span class="legend-cell token-1"></span>
                    <span class="legend-cell token-2"></span>
                    <span class="legend-cell token-3"></span>
                    <span class="legend-cell token-4"></span>
                    <span class="legend-label">More</span>
                </div>
                <span class="legend-info-btn" tabindex="0">&#9432;</span>
                <div class="legend-info-panel">
                    <p><strong>Token 统计</strong>：统计 <strong>Claude Code</strong>、<strong>OpenCode</strong>、<strong>Hermes</strong>、<strong>agy</strong>、<strong>ZCode</strong>、<strong>pi</strong> 及 <strong>Codex CLI</strong> 的 token 消耗，不包含其他 AI 工具或平台。每个会话结束时，按 <code>session_id</code> 记录总消耗，归入<strong>会话结束当日</strong>。</p>
                    <p><strong>跑步数据</strong>：来自 Garmin Connect CN，颜色基准 5km。</p>
                    <p><strong>可能的误差</strong>：</p>
                    <ul>
                        <li>跨天会话的所有 token 均计入结束日，开始日数据会偏低</li>
                        <li>使用 <code>--resume</code> 恢复会话后，transcript 为全量，可能导致旧 token 被重复计入新日期</li>
                    </ul>
                    <p class="legend-info-note">以上场景实际发生频率较低，不影响整体趋势参考。</p>
                </div>
            </div>
            <div class="agent-distribution" id="agent-distribution"></div>
        </header>

        <section class="post-list">
            <% posts.forEach(post => { %>
                <div class="post-item" >
                    <time>
                        <%= post.date %>
                    </time>
                    <h2>
                        <a href="<%= post.url %>" style="text-decoration: none; color: var(--text-main);"><%= post.title %></a>
                    </h2>
                    <% if (post.subtitle) { %>
                        <p></p>
                    <% } %>
                </div>
            <% }) %>
        </section>
    </main>

<%- include('_footer') %>
    <script>
    (function() {
        function esc(s) {
            var d = document.createElement('div');
            d.appendChild(document.createTextNode(s));
            return d.innerHTML;
        }

        var data = <%- dailyData %>;
        if (!data || !data.days || data.days.length === 0) return;

        // --- Agent metadata: brand color + inline SVG logo ---
        var AGENT_META = {
            claude:   { name: 'Claude Code',  color: '#DA7756' },
            opencode: { name: 'OpenCode',     color: '#00A6F0' },
            hermes:   { name: 'Hermes',       color: '#7C3AED' },
            agy:      { name: 'Antigravity',  color: '#4285F4' },
            zcode:    { name: 'ZCode',        color: '#00B894' },
            pi:       { name: 'pi',           color: '#E84393' },
            codex:    { name: 'Codex CLI',    color: '#10A37F' }
        };
        var AGENT_SVG = {
            // Anthropic "A"
            claude:   '<path d="M4 14L8 2L12 14M5.5 10h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
            // Code brackets < >
            opencode: '<path d="M5.5 4.5L2 8l3.5 3.5M10.5 4.5L14 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
            // Lightning bolt
            hermes:   '<path d="M9 1L3 9h4l-2 6 7-9H8l1-5z" fill="currentColor"/>',
            // Gemini sparkle
            agy:      '<path d="M8 0c.3 4.3 3.7 7.7 8 8-4.3.3-7.7 3.7-8 8-.3-4.3-3.7-7.7-8-8 4.3-.3 7.7-3.7 8-8z" fill="currentColor"/>',
            // Z in rounded rect
            zcode:    '<rect x="1.5" y="1.5" width="13" height="13" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5 5.5h6L5 10.5h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
            // π symbol
            pi:       '<text x="8" y="12.5" text-anchor="middle" font-size="13" font-family="Georgia,serif" font-weight="700" fill="currentColor">π</text>',
            // Codex "X" mark
            codex:    '<path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>'
        };
        function agentIcon(src) {
            var path = AGENT_SVG[src];
            if (!path) return '<svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="6" fill="currentColor"/></svg>';
            return '<svg viewBox="0 0 16 16" width="14" height="14">' + path + '</svg>';
        }
        function agentName(src) { return (AGENT_META[src] && AGENT_META[src].name) || src; }
        function agentColor(src) { return (AGENT_META[src] && AGENT_META[src].color) || '#64748b'; }

        var tokenMap = {};
        var runningMap = {};
        var sourceMap = {};
        data.days.forEach(function(d) {
            if (d.total_tokens) {
                var t = d.total_tokens;
                tokenMap[d.date] = t.input + t.output + t.cache_read + t.cache_creation + (t.reasoning || 0);
                if (t.bySource) sourceMap[d.date] = t.bySource;
            }
            if (d.running_km) runningMap[d.date] = d.running_km;
        });

        var today = new Date();
        var todayStr = today.getFullYear() + '-' +
            String(today.getMonth() + 1).padStart(2, '0') + '-' +
            String(today.getDate()).padStart(2, '0');

        var oneYearAgo = new Date(today);
        oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
        var dayOfWeek = oneYearAgo.getDay();
        var mondayOffset = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
        var startDate = new Date(oneYearAgo);
        startDate.setDate(startDate.getDate() + mondayOffset);

        var weeks = [];
        var monthLabels = [];
        var lastMonth = -1;

        function toDateStr(d) {
            return d.getFullYear() + '-' +
                String(d.getMonth() + 1).padStart(2, '0') + '-' +
                String(d.getDate()).padStart(2, '0');
        }

        while (toDateStr(startDate) <= todayStr) {
            var week = [];
            for (var i = 0; i < 7; i++) {
                var dateStr = toDateStr(startDate);
                var month = startDate.getMonth();
                if (i === 0 && month !== lastMonth) {
                    monthLabels.push({
                        month: startDate.toLocaleString('zh-CN', { month: 'short' }),
                        weekIndex: weeks.length
                    });
                    lastMonth = month;
                }
                week.push({
                    date: dateStr,
                    tokens: tokenMap[dateStr] || 0,
                    running: runningMap[dateStr] || 0,
                    future: dateStr > todayStr
                });
                startDate.setDate(startDate.getDate() + 1);
            }
            weeks.push(week);
        }

        // Token color levels (quartile-based, all data)
        var tokenValues = Object.values(tokenMap).filter(function(v) { return v > 0; }).sort(function(a, b) { return a - b; });
        function getQuantile(arr, q) {
            var pos = (arr.length - 1) * q;
            var base = Math.floor(pos);
            var rest = pos - base;
            if (arr[base + 1] !== undefined) return arr[base] + rest * (arr[base + 1] - arr[base]);
            return arr[base];
        }
        var q1 = tokenValues.length > 0 ? getQuantile(tokenValues, 0.25) : 0;
        var q2 = tokenValues.length > 0 ? getQuantile(tokenValues, 0.5) : 0;
        var q3 = tokenValues.length > 0 ? getQuantile(tokenValues, 0.75) : 0;

        function getTokenLevel(v) {
            if (v === 0) return 0;
            if (v <= q1) return 1;
            if (v <= q2) return 2;
            if (v <= q3) return 3;
            return 4;
        }

        function getRunLevel(km) {
            if (km <= 0) return 0;
            if (km < 3) return 1;
            if (km < 5) return 2;
            if (km < 10) return 3;
            if (km < 15) return 4;
            return 5;
        }

        function formatRunning(km) {
            return km < 10 ? km.toFixed(1) : km.toFixed(0);
        }

        function formatTokens(n) {
            if (n >= 1e6) return (n / 1e6).toFixed(1) + ' M';
            if (n >= 1e3) {
                var k = n / 1e3;
                return (k >= 100 ? k.toFixed(0) : k.toFixed(1)) + ' K';
            }
            return String(n);
        }

        // Render month labels
        var monthsEl = document.getElementById('contrib-months');
        var monthHtml = '';
        var prevWeekIdx = -10;
        monthLabels.forEach(function(m) {
            var offset = m.weekIndex * 14;
            if (m.weekIndex > prevWeekIdx + 3) {
                monthHtml += '<span style="position:absolute;left:' + offset + 'px">' + m.month + '</span>';
                prevWeekIdx = m.weekIndex;
            }
        });
        monthsEl.innerHTML = monthHtml;

        // Render grid
        var totalWeeks = weeks.length;
        var edgeCount = 8;
        var gridEl = document.getElementById('contrib-grid');
        var gridHtml = '';

        weeks.forEach(function(week, wi) {
            week.forEach(function(day, di) {
                if (day.future) {
                    gridHtml += '<span class="contrib-cell" data-date="' + day.date + '" style="grid-column:' + (wi + 1) + ';grid-row:' + (di + 1) + '"></span>';
                    return;
                }

                var hasRun = day.running > 0;
                var hasTok = day.tokens > 0;
                var runLvl = getRunLevel(day.running);
                var tokLvl = getTokenLevel(day.tokens);

                var bg;
                if (hasRun && hasTok) {
                    bg = 'background:linear-gradient(90deg,var(--run-' + runLvl + ') 50%,var(--token-' + tokLvl + ') 50%)';
                } else if (hasRun) {
                    bg = 'background:var(--run-' + runLvl + ')';
                } else if (hasTok) {
                    bg = 'background:var(--token-' + tokLvl + ')';
                } else {
                    bg = 'background:var(--empty-cell)';
                }

                var cls = 'contrib-cell';
                if (wi < edgeCount) cls += ' edge-left';
                if (wi >= totalWeeks - edgeCount) cls += ' edge-right';

                var runStr = (hasRun ? formatRunning(day.running) : '0') + ' km';
                var tokStr = hasTok ? formatTokens(day.tokens) : '0 M';
                var tooltip = day.date + '\n🏃 ' + runStr + '\n💻 ' + tokStr;
                var daySources = sourceMap[day.date];
                if (daySources) {
                    Object.keys(daySources).sort(function(a,b) { return daySources[b]-daySources[a]; }).forEach(function(src) {
                        tooltip += '\n  ' + agentName(src) + ': ' + formatTokens(daySources[src]);
                    });
                }
                var ariaLabel = day.date + ', ' + runStr + ' running, ' + tokStr + ' tokens';

                gridHtml += '<span class="' + cls + '" data-date="' + day.date + '" data-tooltip="' + esc(tooltip) + '" role="button" tabindex="0" aria-label="' + esc(ariaLabel) + '" style="' + bg + ';grid-column:' + (wi + 1) + ';grid-row:' + (di + 1) + '"></span>';
            });
        });
        gridEl.innerHTML = gridHtml;

        // Summary statistics
        var totalTokens = 0, totalRunning = 0, activeDays = 0;
        weeks.forEach(function(week) {
            week.forEach(function(day) {
                if (day.future) return;
                if (day.tokens > 0) { totalTokens += day.tokens; }
                if (day.running > 0) { totalRunning += day.running; }
                if (day.tokens > 0 || day.running > 0) { activeDays++; }
            });
        });
        var summaryParts = [];
        if (totalTokens > 0) summaryParts.push(formatTokens(totalTokens) + ' tokens');
        if (totalRunning > 0) summaryParts.push(totalRunning.toFixed(0) + ' km');
        if (activeDays > 0) summaryParts.push(activeDays + ' 天活跃');
        var summaryEl = document.getElementById('contrib-summary');
        if (summaryEl && summaryParts.length > 0) {
            summaryEl.textContent = '· ' + summaryParts.join(' · ');
        }

        // Render agent distribution badges
        var bySourceTotal = data.bySourceTotal || {};
        var sourceEntries = Object.keys(bySourceTotal).map(function(k) {
            return { source: k, tokens: bySourceTotal[k] };
        }).sort(function(a, b) { return b.tokens - a.tokens; });
        var grandTotal = sourceEntries.reduce(function(s, e) { return s + e.tokens; }, 0);
        var agentHtml = sourceEntries.map(function(e) {
            var pct = grandTotal > 0 ? (e.tokens / grandTotal * 100).toFixed(1) : '0';
            return '<div class="agent-badge" style="color:' + agentColor(e.source) + '">' +
                '<span class="agent-logo">' + agentIcon(e.source) + '</span>' +
                '<span class="agent-name">' + agentName(e.source) + '</span>' +
                '<span class="agent-tokens">' + formatTokens(e.tokens) + '</span>' +
                '<span class="agent-pct">' + pct + '%</span>' +
                '</div>';
        }).join('');
        var agentEl = document.getElementById('agent-distribution');
        if (agentEl) agentEl.innerHTML = agentHtml;

        // Info panel click toggle (touch-friendly)
        var infoBtn = document.querySelector('.legend-info-btn');
        var infoPanel = document.querySelector('.legend-info-panel');
        if (infoBtn && infoPanel) {
            infoBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                infoPanel.classList.toggle('active');
            });
            infoBtn.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    infoPanel.classList.toggle('active');
                }
            });
            document.addEventListener('click', function(e) {
                if (!infoPanel.contains(e.target) && e.target !== infoBtn) {
                    infoPanel.classList.remove('active');
                }
            });
        }
    })();
    </script>
</body>
</html>